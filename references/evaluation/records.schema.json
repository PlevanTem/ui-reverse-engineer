{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:restore:codex-evaluation-records:v1",
  "oneOf": [
    {
      "$ref": "#/$defs/checkpoint"
    },
    {
      "$ref": "#/$defs/job"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checkpoint_id",
        "run_id",
        "artifact_sha256",
        "contract_sha256",
        "environment_sha256",
        "implementation_sha256",
        "source_cursor",
        "source_snapshot_sha256",
        "config_sha256",
        "contract_frozen"
      ],
      "properties": {
        "schema_version": {
          "const": "CodexEvaluationCheckpoint/v1"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/hash"
        },
        "run_id": {
          "type": "string"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/hash"
        },
        "contract_sha256": {
          "$ref": "#/$defs/hash"
        },
        "environment_sha256": {
          "$ref": "#/$defs/hash"
        },
        "implementation_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_snapshot_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_sha256": {
          "$ref": "#/$defs/hash"
        },
        "contract_frozen": {
          "type": "boolean"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "checkpoint_id",
        "suite",
        "adapter_sha256",
        "state",
        "created_at",
        "result"
      ],
      "properties": {
        "schema_version": {
          "const": "CodexEvaluationJob/v1"
        },
        "job_id": {
          "$ref": "#/$defs/hash"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/hash"
        },
        "suite": {
          "$ref": "urn:restore:codex-evaluation-config:v1#/properties/suites/items"
        },
        "adapter_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "uncertain",
            "stale",
            "completed",
            "failed"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "failure": {
          "type": "string"
        },
        "result": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          },
          "required": [
            "uri",
            "sha256"
          ],
          "additionalProperties": false
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "checkpoint_id",
        "artifact_sha256",
        "contract_sha256",
        "feedback",
        "scope",
        "result"
      ],
      "properties": {
        "schema_version": {
          "const": "CodexEvaluationResult/v1"
        },
        "job_id": {
          "$ref": "#/$defs/hash"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/hash"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/hash"
        },
        "contract_sha256": {
          "$ref": "#/$defs/hash"
        },
        "feedback": {
          "const": "developer"
        },
        "scope": {
          "const": "development_only"
        },
        "result": {
          "type": "object",
          "required": [
            "status"
          ]
        }
      }
    }
  }
}
