{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-reverse-engineer:FinalEvalRequest/v0.2",
  "title": "Final artifact E2E grader request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding", "reference_evidence", "states", "resources", "obligations", "start_command", "project_path", "deadline"],
  "properties": {
    "schema_version": { "const": "FinalEvalRequest/v0.2" },
    "case_id": { "type": "string", "minLength": 1 },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "reference_sha256", "contract_sha256", "environment_sha256", "rubric_version", "scorer_version"],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "reference_sha256": { "$ref": "#/$defs/sha256" },
        "contract_sha256": { "$ref": "#/$defs/sha256" },
        "environment_sha256": { "$ref": "#/$defs/sha256" },
        "rubric_version": { "type": "string", "minLength": 1 },
        "scorer_version": { "type": "string", "minLength": 1 }
      }
    },
    "reference_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "states": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } }, "additionalProperties": true } },
    "resources": { "type": "array", "items": { "type": "object", "required": ["kind", "url"], "properties": { "kind": { "type": "string" }, "url": { "type": "string", "format": "uri" } }, "additionalProperties": true } },
    "obligations": { "type": "array", "items": { "type": "object", "required": ["id", "state_id", "region_id", "expected"], "properties": { "id": { "type": "string" }, "state_id": { "type": "string" }, "region_id": { "type": "string" }, "expected": { "type": "string" }, "reference_evidence": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
    "redline_profile": { "type": ["object", "null"], "description": "When present, validate as RedlineProfile/v1. Required by grader for rubric site-restore-v1.1-draft." },
    "start_command": { "type": "string" },
    "project_path": { "type": "string", "minLength": 1 },
    "deadline": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "binding": { "properties": { "rubric_version": { "const": "site-restore-v1.1-draft" } }, "required": ["rubric_version"] } }, "required": ["binding"] },
      "then": { "required": ["case_id", "redline_profile"], "properties": { "redline_profile": { "type": "object" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "uri", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["screenshot", "sequence", "video", "checks", "source"] },
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    }
  }
}
