{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-reverse-engineer:BlindPairwiseRequest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "task", "reference", "A", "B", "expected_output", "choices"],
  "properties": {
    "schema_version": {"const": "BlindPairwiseRequest/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "states", "expected"],
      "properties": {
        "scope": {"const": "visual_only"},
        "states": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["state", "viewport"], "properties": {"state": {"type": "string"}, "viewport": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}}}}},
        "expected": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "expected"], "properties": {"criterion_id": {"enum": ["C1", "C2", "C3"]}, "expected": {"type": "string"}, "importance": {"type": "string"}}}}
      }
    },
    "reference": {"$ref": "#/$defs/items"},
    "A": {"$ref": "#/$defs/items"},
    "B": {"$ref": "#/$defs/items"},
    "expected_output": {"const": "BlindPairwiseVerdict/v1"},
    "choices": {"const": ["A", "B", "same", "uncertain"]}
  },
  "$defs": {
    "media": {"type": "object", "additionalProperties": false, "required": ["mime_type", "data_base64"], "properties": {"mime_type": {"enum": ["image/png", "image/jpeg", "image/webp", "video/mp4", "video/webm"]}, "data_base64": {"type": "string", "minLength": 1, "contentEncoding": "base64"}, "state": {"type": "string"}}},
    "item": {"oneOf": [{"$ref": "#/$defs/media"}, {"type": "object", "additionalProperties": false, "required": ["kind", "frames"], "properties": {"kind": {"const": "sequence"}, "frames": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["offset_ms", "media"], "properties": {"offset_ms": {"type": ["number", "null"], "minimum": 0}, "sample_timing": {"type": "object", "additionalProperties": false, "properties": {"scheduled_ms": {"type": "number"}, "actual_offset_ms": {"type": "number"}}}, "media": {"$ref": "#/$defs/media"}}}}}}]},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  }
}
