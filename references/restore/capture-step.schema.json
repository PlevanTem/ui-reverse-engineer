{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-reverse-engineer:CaptureStep:v1",
  "type": "object", "additionalProperties": false, "required": ["action"],
  "properties": {
    "action": {"enum": ["click", "hover", "key", "key_hold", "scroll", "wait", "drag", "wheel", "fill", "select", "reload"]},
    "selector": {"type": "string", "minLength": 1}, "ready_selector": {"type": "string", "minLength": 1},
    "position": {"$ref": "#/$defs/point"}, "key": {"type": "string", "minLength": 1},
    "duration_ms": {"$ref": "#/$defs/duration"}, "ms": {"$ref": "#/$defs/duration"},
    "x": {"type": "number"}, "y": {"type": "number"}, "delta_x": {"type": "number"}, "delta_y": {"type": "number"},
    "value": {"type": "string"},
    "capture_at_ms": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/duration"}, "$comment": "For key_hold, semantic validation requires every offset <= duration_ms; samples are measured from keydown while the key remains held. Other actions sample after input completion."},
    "path": {"type": "array", "minItems": 2, "maxItems": 100, "items": {"allOf": [
      {"$ref": "#/$defs/point"}, {"type": "object", "required": ["at_ms"], "properties": {"at_ms": {"$ref": "#/$defs/duration"}, "capture": {"type": "boolean"}}}
    ]}}
  },
  "allOf": [
    {"if": {"properties": {"action": {"enum": ["click", "hover", "drag", "wheel", "fill", "select"]}}}, "then": {"required": ["selector"]}},
    {"if": {"properties": {"action": {"enum": ["key", "key_hold"]}}}, "then": {"required": ["key"]}},
    {"if": {"properties": {"action": {"const": "key_hold"}}}, "then": {"required": ["duration_ms"]}},
    {"if": {"properties": {"action": {"const": "wait"}}}, "then": {"required": ["ms"]}},
    {"if": {"properties": {"action": {"const": "scroll"}}}, "then": {"required": ["y"]}},
    {"if": {"properties": {"action": {"const": "wheel"}}}, "then": {"required": ["delta_x", "delta_y"]}},
    {"if": {"properties": {"action": {"enum": ["fill", "select"]}}}, "then": {"required": ["value"]}},
    {"if": {"properties": {"action": {"const": "drag"}}}, "then": {"required": ["path"]}}
  ],
  "$defs": {
    "point": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}},
    "duration": {"type": "number", "minimum": 0, "maximum": 5000}
  }
}
