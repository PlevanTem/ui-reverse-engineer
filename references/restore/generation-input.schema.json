{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-reverse-engineer:RestoreGenerationInput:v1",
  "title": "Restore allowlisted generation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "generation_policy", "binding", "requested_url", "observed_url", "states", "obligations", "reference_evidence", "resources", "unknowns", "output"],
  "properties": {
    "schema_version": {"const": "RestoreGenerationInput/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": ["string", "null"]},
    "generation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "case_metadata_visibility", "source_reuse"],
      "properties": {
        "mode": {"enum": ["fixture_only", "source_assisted"]},
        "case_metadata_visibility": {"const": "id_only"},
        "source_reuse": {"enum": ["forbidden", "allowed"]}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_sha256", "reference_sha256"],
      "properties": {
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "reference_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "requested_url": {"type": "string", "minLength": 1},
    "observed_url": {"type": "string", "minLength": 1},
    "states": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "obligations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "interactive_scene": {"type": ["object", "null"]},
    "reference_evidence": {"type": "array", "items": {"type": "object"}},
    "resources": {"type": "array", "items": {"type": "object"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_path", "start_command"],
      "properties": {
        "project_path": {"const": "restored/"},
        "start_command": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
