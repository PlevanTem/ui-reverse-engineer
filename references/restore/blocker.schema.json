{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-reverse-engineer:RestoreBlocker:v1",
  "type": "object", "required": ["schema_version", "scope", "reason", "evidence", "attempts", "remaining_work"],
  "properties": {
    "schema_version": {"const": "RestoreBlocker/v1"},
    "scope": {"enum": ["reference_capture", "assets", "runtime", "loop_measure", "loop_verify"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "uri", "sha256"], "properties": {
      "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["screenshot", "sequence", "video", "checks", "source"]},
      "uri": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }}},
    "attempts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["capability", "status", "reason", "evidence"], "properties": {
      "capability": {"type": "string", "minLength": 1}, "status": {"enum": ["failed", "unavailable"]},
      "reason": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/references"}
    }}},
    "remaining_work": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["task", "status", "reason", "evidence"], "properties": {
      "task": {"type": "string", "minLength": 1}, "status": {"enum": ["done", "blocked", "not_applicable"]},
      "reason": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/references"}
    }}}
  },
  "$defs": {"references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
}
