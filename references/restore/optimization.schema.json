{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "RestoreOptimization/v1"
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage"
          },
          "minItems": 1
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          },
          "minItems": 0
        },
        "resource_layout": {
          "$ref": "#/$defs/layout"
        }
      },
      "required": [
        "coverage",
        "unknowns",
        "resource_layout"
      ]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          },
          "minItems": 0
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          },
          "minItems": 0
        }
      },
      "required": [
        "tokens",
        "regions"
      ]
    },
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "minItems": 1
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logical_states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "minItems": 0
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          },
          "minItems": 0
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "minItems": 0
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant"
          },
          "minItems": 0
        }
      },
      "required": [
        "variables",
        "transitions",
        "tracks",
        "invariants"
      ]
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          },
          "minItems": 0
        }
      },
      "required": [
        "required",
        "cues"
      ]
    },
    "routing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 0
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "blind/v1",
            "legacy/v0.2"
          ]
        }
      },
      "required": [
        "protocol"
      ]
    }
  },
  "required": [
    "schema_version",
    "preparation",
    "design",
    "plan",
    "behavior",
    "audio",
    "verification"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-reverse-engineer:RestoreOptimization:v1",
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position_ratio": {
          "type": "number",
          "minimum": 0
        },
        "size_ratio": {
          "type": "number",
          "minimum": 0
        },
        "min_px": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": []
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "variable_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "number",
                "boolean",
                "string"
              ]
            }
          },
          "required": [
            "op",
            "variable_id",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "not"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ]
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "observed",
            "measured",
            "inferred",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "kind",
        "required",
        "status",
        "evidence"
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "blocking",
        "reason"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "asset_root": {
          "anyOf": [
            {
              "const": "."
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|[/\\\\])\\.{1,2}(?:[/\\\\]|$))[^:]+$"
            }
          ]
        },
        "category_paths": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|[/\\\\])\\.{1,2}(?:[/\\\\]|$))[^:]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "profile",
        "asset_root",
        "category_paths"
      ]
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "measured",
            "inferred",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "type",
        "value",
        "status",
        "evidence"
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_space": {
          "enum": [
            "viewport",
            "document"
          ]
        },
        "reference_box": {
          "$ref": "#/$defs/box"
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "tolerances": {
          "$ref": "#/$defs/tolerances"
        },
        "status": {
          "enum": [
            "observed",
            "measured",
            "inferred",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "state_id",
        "coordinate_space",
        "status",
        "evidence"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "state_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "region_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "acceptance_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "summary",
        "state_ids",
        "region_ids",
        "resource_ids",
        "depends_on",
        "priority",
        "acceptance_refs"
      ]
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "initial": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "initial"
      ]
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variable_id": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "set",
            "add"
          ]
        },
        "value": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        }
      },
      "required": [
        "variable_id",
        "op",
        "value"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "guard": {
          "$ref": "#/$defs/condition"
        },
        "updates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/update"
          },
          "minItems": 0
        },
        "status": {
          "enum": [
            "observed",
            "measured",
            "inferred",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "from": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "state_id",
        "from",
        "to",
        "event",
        "updates",
        "status",
        "evidence"
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "transition_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "enum": [
            "time",
            "scroll",
            "input",
            "physics"
          ]
        },
        "coordinate_space": {
          "enum": [
            "viewport",
            "document",
            "object",
            "world"
          ]
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "delay_ms": {
          "type": "number",
          "minimum": 0
        },
        "easing": {
          "type": "string",
          "minLength": 1
        },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "offset": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              }
            },
            "required": [
              "offset",
              "value"
            ]
          },
          "minItems": 1
        },
        "status": {
          "enum": [
            "observed",
            "measured",
            "inferred",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "transition_id",
        "target_id",
        "property",
        "driver",
        "keyframes",
        "status",
        "evidence"
      ]
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "observed",
            "measured",
            "inferred",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "condition",
        "status",
        "evidence"
      ]
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "transition_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "loop": {
          "type": "boolean"
        },
        "overlap": {
          "enum": [
            "ignore",
            "restart",
            "overlap"
          ]
        },
        "reset": {
          "enum": [
            "stop",
            "restart",
            "preserve"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "measured",
            "inferred",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "state_id",
        "resource_id",
        "trigger",
        "loop",
        "overlap",
        "reset",
        "status",
        "evidence"
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "enum": [
            "dom",
            "svg",
            "image",
            "video",
            "3d",
            "canvas2d"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "state_id",
        "region_id",
        "representation",
        "reason"
      ]
    }
  },
  "description": "Structural contract. Cross-reference, state-region identity, coverage, dependency cycles and bounded expression semantics are additionally checked by optimization.mjs."
}
