{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:ui-reverse-engineer:RestoreTask:v1",
  "title":"Restore task continuity checkpoint",
  "type":"object","additionalProperties":false,
  "required":["schema_version","task_id","objective","started_at","policy","status","reason","owner_session","runs","active_run","stop_requests","stalled_stops","last_fingerprint","last_stop","plan","pending_handoff","proposals"],
  "properties":{
    "schema_version":{"const":"RestoreTask/v1"},"task_id":{"type":"string","minLength":1},"objective":{"type":"string","minLength":1},
    "started_at":{"type":"string","format":"date-time"},"policy":{"$ref":"#/$defs/policy"},
    "status":{"enum":["active","paused","waiting","limited","accepted"]},"reason":{"type":["string","null"]},"owner_session":{"type":["string","null"]},
    "runs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["root","run_id"],"properties":{"root":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1}}}},
    "active_run":{"type":"string","minLength":1},"stop_requests":{"type":"integer","minimum":0},"stalled_stops":{"type":"integer","minimum":0},
    "last_fingerprint":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "last_stop":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["turn_id","fingerprint","output"],"properties":{"turn_id":{"type":"string","minLength":1},"fingerprint":{"$ref":"#/$defs/hash"},"output":{"type":"object"}}}]},
    "plan":{"anyOf":[{"$ref":"#/$defs/ref"},{"type":"null"}]},
    "pending_handoff":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["id","mode","parent_run_id","parent_run_sha256","parent_events_sha256","child_contract_sha256","child","stage"],"properties":{"id":{"$ref":"#/$defs/hash"},"mode":{"enum":["continue","refreeze"]},"parent_run_id":{"type":"string"},"parent_run_sha256":{"$ref":"#/$defs/hash"},"parent_events_sha256":{"$ref":"#/$defs/hash"},"child_contract_sha256":{"$ref":"#/$defs/hash"},"child":{"type":"string"},"stage":{"type":"string"}}}]},
    "proposals":{"type":"array","items":{"$ref":"#/$defs/ref"}}
  },
  "$defs":{
    "status_view":{
      "type":"object","additionalProperties":false,"required":["schema_version","task_id","status","action","active_run","remaining_ms","completed_rounds","run_count","provisional","reason","fingerprint"],
      "properties":{"schema_version":{"const":"RestoreTaskStatus/v1"},"task_id":{"type":"string","minLength":1},"status":{"enum":["active","paused","waiting","limited","accepted"]},"action":{"enum":["none","prepare","baseline_measure","build_candidate","measure_verify","abort_candidate","loop_next","final_e2e","repair_evaluation","learn_plan","handoff","accepted"]},"active_run":{"type":"string","minLength":1},"remaining_ms":{"type":"number","minimum":0},"completed_rounds":{"type":"integer","minimum":0},"run_count":{"type":"integer","minimum":1},"provisional":{"type":["boolean","null"]},"reason":{"type":["string","null"]},"fingerprint":{"$ref":"#/$defs/hash"}}
    },
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "ref":{"type":"object","additionalProperties":false,"required":["uri","sha256"],"properties":{"uri":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/hash"}}},
    "policy":{"type":"object","additionalProperties":false,"required":["scope","evaluation","max_wall_ms","max_runs","max_total_rounds","max_stop_requests","max_stalled_stops"],"properties":{
      "scope":{"const":"website_and_skill_proposals"},"evaluation":{"const":"development"},
      "max_wall_ms":{"$ref":"#/$defs/limit"},"max_runs":{"$ref":"#/$defs/limit"},"max_total_rounds":{"$ref":"#/$defs/limit"},"max_stop_requests":{"$ref":"#/$defs/limit"},"max_stalled_stops":{"$ref":"#/$defs/limit"}}},
    "limit":{"type":"integer","minimum":1,"maximum":9007199254740991}
  }
}
