{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-reverse-engineer:DatasetSnapshot:v1",
  "title": "Versioned offline dataset snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "created_at", "source_packages", "counts", "split_policy", "duplicates", "files"],
  "properties": {
    "schema_version": {"const": "DatasetSnapshot/v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_packages": {"type": "array", "items": {"type": "object", "required": ["episode_id", "manifest_sha256"], "properties": {"episode_id": {"type": "string"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}},
    "counts": {"type": "object"},
    "split_policy": {"type": "object"},
    "duplicates": {"type": "array", "items": {"type": "string"}},
    "files": {"type": "object", "required": ["episodes_sha256", "steps_sha256", "quarantine_sha256"], "properties": {"episodes_sha256": {"$ref": "#/$defs/sha256"}, "steps_sha256": {"$ref": "#/$defs/sha256"}, "quarantine_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
