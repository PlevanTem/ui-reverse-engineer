{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-reverse-engineer:AgentEpisode:v1",
  "title": "Restore governance sidecar derived from one Harbor trial",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "trial_id", "task_name", "case_id", "source_policy", "started_at", "completed_at", "task", "outcome", "steps", "eligibility", "quarantine", "provenance", "fingerprint"],
  "properties": {
    "schema_version": {"const": "AgentEpisode/v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "task_name": {"type": "string", "minLength": 1},
    "case_id": {"type": ["string", "null"]},
    "source_policy": {"type": ["object", "null"]},
    "started_at": {"type": ["string", "null"]},
    "completed_at": {"type": ["string", "null"]},
    "task": {"type": "object"},
    "outcome": {"type": "object", "required": ["stop_reason", "formal_rewards", "data_status"]},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "eligibility": {"$ref": "#/$defs/eligibility"},
    "quarantine": {"type": "boolean"},
    "provenance": {"type": "object", "required": ["harbor_version", "atif_version", "trajectory_index"]},
    "dataset": {"type": "object"},
    "fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "item": {"type": "object", "additionalProperties": false, "required": ["eligible", "reasons"], "properties": {"eligible": {"type": "boolean"}, "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "eligibility": {"type": "object", "additionalProperties": false, "required": ["trajectory", "sft", "preference", "rl"], "properties": {"trajectory": {"$ref": "#/$defs/item"}, "sft": {"$ref": "#/$defs/item"}, "preference": {"$ref": "#/$defs/item"}, "rl": {"$ref": "#/$defs/item"}}}
  }
}
