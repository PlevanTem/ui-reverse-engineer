{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-reverse-engineer:RestoreFixtureManifest:v1",
  "title": "Frozen fixture required before a case can compile to Harbor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "url", "tier", "source_policy", "environment", "viewports", "states", "reference_evidence", "resources"],
  "properties": {
    "schema_version": {"const": "RestoreFixtureManifest/v1"},
    "case_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "tier": {"enum": ["ordinary", "refined", "complex"]},
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source_reuse"],
      "properties": {
        "mode": {"enum": ["fixture_only", "source_assisted"]},
        "source_reuse": {"enum": ["forbidden", "allowed"]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker_image"],
      "properties": {"docker_image": {"type": "string", "pattern": "^[^\\s@]+(?::[^\\s@]+)?@sha256:[a-f0-9]{64}$"}}
    },
    "viewports": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "states": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}},
    "reference_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "uri", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "host": {"type": ["string", "null"], "pattern": "^(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)$"}
        }
      }
    }
  }
}
