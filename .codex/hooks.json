{
  "description": "Opt-in Restore task continuity. No effect without an explicitly bound development task/session. Review exact definitions before trusting.",
  "hooks": {
    "SessionStart": [{"matcher":"startup|resume|clear|compact","hooks":[{"type":"command","command":"node \"$(git rev-parse --show-toplevel)/scripts/restore/hooks.mjs\"","commandWindows":"node ((git rev-parse --show-toplevel) + '/scripts/restore/hooks.mjs')","timeout":10}]}],
    "PreCompact": [{"hooks":[{"type":"command","command":"node \"$(git rev-parse --show-toplevel)/scripts/restore/hooks.mjs\"","commandWindows":"node ((git rev-parse --show-toplevel) + '/scripts/restore/hooks.mjs')","timeout":10}]}],
    "PostCompact": [{"hooks":[{"type":"command","command":"node \"$(git rev-parse --show-toplevel)/scripts/restore/hooks.mjs\"","commandWindows":"node ((git rev-parse --show-toplevel) + '/scripts/restore/hooks.mjs')","timeout":10}]}],
    "Stop": [{"hooks":[{"type":"command","command":"node \"$(git rev-parse --show-toplevel)/scripts/restore/hooks.mjs\"","commandWindows":"node ((git rev-parse --show-toplevel) + '/scripts/restore/hooks.mjs')","timeout":10}]}],
    "Interrupt": [{"hooks":[{"type":"command","command":"node \"$(git rev-parse --show-toplevel)/scripts/restore/hooks.mjs\"","commandWindows":"node ((git rev-parse --show-toplevel) + '/scripts/restore/hooks.mjs')","timeout":3}]}]
  }
}
