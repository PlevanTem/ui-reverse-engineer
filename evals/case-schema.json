{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-reverse-engineer.local/evals/case-schema.json",
  "title": "UI Reverse Engineer evaluation case dataset",
  "description": "Dataset schema for reusable HTML restoration evaluation cases.",
  "type": "object",
  "required": ["schema_version", "ui_types", "task_types", "cases"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2"
    },
    "ui_types": {
      "type": "array",
      "description": "User-maintainable UI/product-shape catalog, such as dashboard, commerce, or content site.",
      "items": { "$ref": "#/$defs/typeEntry" }
    },
    "task_types": {
      "type": "array",
      "description": "User-maintainable reverse-engineering task catalog, such as restore, transfer, or design-system extraction.",
      "items": { "$ref": "#/$defs/typeEntry" }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "typeEntry": {
      "type": "object",
      "required": ["id", "name", "archived"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Stable machine ID; do not change after cases reference it."
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "archived": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "title",
        "ui_type_id",
        "task_type_id",
        "description",
        "keywords",
        "url",
        "technology_stack",
        "difficulty",
        "input_kinds",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]*$",
          "description": "Stable case ID, unique within the dataset."
        },
        "title": { "type": "string", "minLength": 1 },
        "ui_type_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Must refer to a non-archived entry in ui_types."
        },
        "task_type_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Must refer to a non-archived entry in task_types."
        },
        "description": {
          "type": "string",
          "description": "Short, factual case description. Keep searchable terms in keywords."
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "Reference page URL when available; use null when unknown or not applicable."
        },
        "technology_stack": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Evaluation-only technologies for dataset analysis and stratification. Use [] when unknown; never guess or export this field to generation.",
          "x-data-plane": "evaluation_only",
          "x-generation-export": false
        },
        "technology_stack_source": {
          "type": "string",
          "enum": ["manual", "url_analysis", "source_analysis", "unknown"],
          "default": "unknown",
          "description": "Evaluation-only provenance for technology analysis; never export to generation.",
          "x-data-plane": "evaluation_only",
          "x-generation-export": false
        },
        "technology_stack_evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evaluation-only evidence notes for detected technologies; never export to generation.",
          "x-data-plane": "evaluation_only",
          "x-generation-export": false
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"],
          "description": "Overall difficulty label based on layout density, interaction complexity, asset completeness, reference ambiguity, and responsive scope."
        },
        "input_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["url", "screenshot", "video", "source_code", "local_html", "design_file"]
          }
        },
        "status": {
          "type": "string",
          "enum": ["draft", "ready", "retired"],
          "default": "draft"
        },
        "notes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
